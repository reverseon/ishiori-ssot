local-hostname: "YoRHa"
hostname: "yorha.node.ishiori.net"
cloud-name: "NoCloud-Local"
platform: "nocloud"
distro: "almalinux"
distro-version: "10"
distro-release: "AlmaLinux 10.0"

network:
  version: 2
  ethernets:
    eth0:
      match:
        name: "eth0"
      dhcp4: true
      gateway4: "192.168.0.1"
      nameservers:
        addresses:
          - 192.168.0.1
          - 8.8.8.8
          - 8.8.4.4